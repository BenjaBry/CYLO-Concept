---
---
<aside id="cartDrawer" class="cart-drawer" aria-label="Carrito">
  <div class="cart-head">
    <div>
      <div class="eyebrow">MI SELECCIÓN</div>
      <h3 style="margin:4px 0 0;font-family:var(--serif);font-size:30px">Tu carrito</h3>
    </div>
    <button id="closeCart" class="icon-btn">×</button>
  </div>
  <div id="cartItems" class="cart-items"></div>
  <div class="cart-foot">
    <div class="cart-total">
      <span>Total estimado</span>
      <strong id="cartTotal">Q 0.00</strong>
    </div>
    <button id="checkoutBtn" class="btn btn-dark" style="width:100%">SOLICITAR COMPRA</button>
    <p style="font-size:10px;color:var(--muted);margin:12px 0 0">Coordinamos disponibilidad, entrega y forma de pago de manera personalizada.</p>
  </div>
</aside>
