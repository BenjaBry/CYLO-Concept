---
const { href, text } = Astro.props;
---
<a href={href} class="uiverse-btn">
  <span>{text}</span>
</a>

<style>
.uiverse-btn {
  position: relative;
  padding: 16px 32px;
  border-radius: 50px;
  background: #111;
  color: #fff;
  font-weight: 600;
  text-decoration: none;
  letter-spacing: 1px;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,0.1);
  transition: all 0.3s ease;
}
.uiverse-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}
.uiverse-btn::before {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 100%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: all 0.5s ease;
}
.uiverse-btn:hover::before {
  left: 100%;
}
.uiverse-btn span {
  position: relative;
  z-index: 1;
}
</style>
