---
---
<header class="site-header">
  <div class="container header-main">
    <div class="header-left">
      <button id="menuToggle" class="icon-btn menu-toggle" aria-label="Menú">☰</button>
      <a class="text-link desktop-only" href="/contacto">ATENCIÓN PERSONAL</a>
    </div>
    <a class="brand" href="/">
      <img src="/logo-header.png" alt="CONCEPT CYLO EST. 2005" style="height: 200px; width: auto; object-fit: contain; mix-blend-mode: multiply; margin: -50px 0;">
    </a>
    <div class="header-actions">
      <button id="searchFocus" class="icon-btn optional" aria-label="Buscar">⌕</button>
      <button id="cartBtn" class="icon-btn" style="position:relative" aria-label="Carrito">
        ◐<span class="cart-badge" data-cart-count>0</span>
      </button>
    </div>
  </div>
  <nav id="siteNav" class="nav container">
    <a class="nav-link" data-page="tienda" href="/tienda">TIENDA</a>
    <a class="nav-link" href="/tienda?gender=Mujer">MUJER</a>
    <a class="nav-link" href="/tienda?gender=Hombre">HOMBRE</a>
    <a class="nav-link" href="/tienda?category=Calzado">CALZADO</a>
    <a class="nav-link" href="/tienda?category=Tecnología">TECNOLOGÍA</a>
    <a class="nav-link" href="/tienda?category=Electrodomésticos">HOGAR</a>
    <a class="nav-link" data-page="colecciones" href="/colecciones">COLECCIONES</a>
    <a class="nav-link" data-page="marcas" href="/marcas">MARCAS</a>
    <a class="nav-link" data-page="editorial" href="/editorial">EDITORIAL</a>
    <a class="nav-link" data-page="nosotros" href="/nosotros">NOSOTROS</a>
    <a class="nav-link sale" href="/tienda?category=Sale">SALE</a>
  </nav>
  
  <div class="mega-shell" id="megaShell" aria-hidden="true">
    <div class="mega-inner container">
      <div class="mega-col mega-intro">
        <span class="eyebrow">THE CYLO EDIT</span>
        <h3>Explora por universo.</h3>
        <p>Selecciones curadas, novedades y piezas esenciales reunidas en una navegación más rápida.</p>
        <a class="mega-feature" href="/colecciones"><span>VER COLECCIONES</span><b>→</b></a>
      </div>
      <div class="mega-col">
        <span class="mega-heading">MUJER</span>
        <a href="/tienda?q=Vestido">Vestidos</a>
        <a href="/tienda?q=Blusa">Blusas</a>
        <a href="/tienda?q=Pantalón">Pantalones</a>
        <a href="/tienda?q=Jeans">Jeans</a>
        <a href="/tienda?q=Bolso">Bolsos</a>
      </div>
      <div class="mega-col">
        <span class="mega-heading">HOMBRE</span>
        <a href="/tienda?q=Camisa">Camisas</a>
        <a href="/tienda?q=Chaqueta">Chaquetas</a>
        <a href="/tienda?q=Sneakers">Sneakers</a>
        <a href="/tienda?q=Formal">Formal</a>
        <a href="/tienda?q=Accesorio">Accesorios</a>
      </div>
      <div class="mega-col">
        <span class="mega-heading">UNIVERSOS</span>
        <a href="/tienda?category=Calzado">Calzado</a>
        <a href="/tienda?category=Tecnología">Tecnología</a>
        <a href="/tienda?category=Electrodomésticos">Hogar</a>
        <a href="/tienda?category=Belleza">Belleza</a>
        <a href="/marcas">Marcas</a>
      </div>
      <div class="mega-col mega-visual">
        <div class="mega-visual-card">
          <span>NUEVA TEMPORADA</span>
          <strong>CYLO<br>SELECTION</strong>
          <a href="/colecciones">DESCUBRIR</a>
        </div>
      </div>
    </div>
  </div>
</header>
<div class="container search-wrap">
  <label class="search">
    <span>⌕</span>
    <input id="siteSearchInput" aria-label="Buscar en CONCEPT CYLO" placeholder="Buscar productos, marcas o categorías">
    <span class="search-kbd">ENTER</span>
  </label>
</div>
