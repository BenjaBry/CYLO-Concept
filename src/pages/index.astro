---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Newsletter from '../components/Newsletter.astro';
---
<BaseLayout title="Elegancia que se reconoce. — CONCEPT CYLO" pageClass="home">
  <Header slot="header" />
  
  <section class="hero">
    <div class="hero-media"></div>
    <div class="hero-content">
      <div class="eyebrow">CONCEPT CYLO · EST. 2005</div>
      <h1>Elegancia que<br><em>se reconoce.</em></h1>
      <p>Moda, calzado, tecnología y hogar seleccionados con una mirada más precisa: menos ruido, mejores piezas y una experiencia de compra que se siente propia.</p>
      <div class="actions">
        <a class="btn btn-light" href="/tienda">EXPLORAR COLECCIÓN</a>
        <a class="text-link" style="color:#fff" href="/editorial">VER EDITORIAL</a>
      </div>
    </div>
  </section>
  <section class="section reveal">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">SELECCIÓN CYLO</div>
          <h2>Explora por universo.</h2>
        </div>
        <p>Un catálogo amplio, organizado para que puedas pasar de inspiración a producto sin perderte en miles de referencias.</p>
      </div>
      <div class="category-grid">
        <a class="category-card" href="/tienda?category=Moda">
          <div class="media" style="background-image:url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1100&q=86')"></div>
          <div class="copy">
            <strong>Moda</strong>
            <span>Vestidos · Jeans · Camisas</span>
          </div>
        </a>
        <a class="category-card" href="/tienda?category=Calzado">
          <div class="media" style="background-image:url('https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=1100&q=86')"></div>
          <div class="copy">
            <strong>Calzado</strong>
            <span>Sneakers · Casual · Formal</span>
          </div>
        </a>
        <a class="category-card" href="/tienda?category=Tecnología">
          <div class="media" style="background-image:url('https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=1100&q=86')"></div>
          <div class="copy">
            <strong>Tecnología</strong>
            <span>Mobile · Audio · Computing</span>
          </div>
        </a>
        <a class="category-card" href="/tienda?category=Electrodomésticos">
          <div class="media" style="background-image:url('https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=1100&q=86')"></div>
          <div class="copy">
            <strong>Hogar</strong>
            <span>Cocina · Cuidado · Living</span>
          </div>
        </a>
      </div>
    </div>
  </section>
  <section class="section-sm reveal">
    <div class="container split">
      <div class="media"></div>
      <div class="copy">
        <div class="eyebrow">CURADURÍA / 01</div>
        <h2>Menos cosas.<br><em>Más intención.</em></h2>
        <p>CONCEPT CYLO nace en 2005 con una idea sencilla: ofrecer piezas que tengan sentido juntas. La experiencia se construye desde la selección, la presentación y la atención personalizada.</p>
        <a class="text-link" href="/nosotros">CONOCE NUESTRA HISTORIA</a>
      </div>
    </div>
  </section>
  <section class="section reveal">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">LO QUE ESTÁ PASANDO</div>
          <h2>Selecciones que cambian.</h2>
        </div>
        <a class="text-link" href="/editorial">VER TODO</a>
      </div>
      <div class="feature-grid">
        <a class="feature-card" href="/tienda?category=Moda">
          <div class="media" style="background-image:url('https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1500&q=88')"></div>
          <div class="copy">
            <small>THE NEW EDIT</small>
            <h3>Ciudad, pero mejor.</h3>
            <p>Texturas, siluetas y piezas para el día a día.</p>
          </div>
        </a>
        <a class="feature-card" href="/tienda?category=Tecnología">
          <div class="media" style="background-image:url('https://images.unsplash.com/photo-1496181133206-80ce9b88a853?auto=format&fit=crop&w=1500&q=88')"></div>
          <div class="copy">
            <small>TECH SELECT</small>
            <h3>Lo útil también puede ser bello.</h3>
            <p>Objetos para trabajar, crear y vivir mejor.</p>
          </div>
        </a>
        <a class="feature-card" href="/tienda?category=Calzado">
          <div class="media" style="background-image:url('https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=1500&q=88')"></div>
          <div class="copy">
            <small>THE SHOE ROOM</small>
            <h3>Una buena base cambia todo.</h3>
            <p>Siluetas que funcionan más allá de una temporada.</p>
          </div>
        </a>
      </div>
    </div>
  </section>
  <section class="service-band reveal">
    <div class="container service-grid">
      <article>
        <h4>Envíos nacionales</h4>
        <p>Entrega coordinada a todo Guatemala.</p>
      </article>
      <article>
        <h4>Compra segura</h4>
        <p>Proceso simple y atención personalizada.</p>
      </article>
      <article>
        <h4>Selección curada</h4>
        <p>1,200+ referencias organizadas por universo.</p>
      </article>
      <article>
        <h4>Soporte humano</h4>
        <p>Te ayudamos antes, durante y después.</p>
      </article>
    </div>
  </section>
  
  <CartDrawer slot="cart" />
  
  <div slot="footer">
    <Newsletter />
    <Footer />
  </div>
</BaseLayout>
